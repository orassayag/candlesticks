{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "config/jest/*.js",
    "src/api/**/*.{js,jsx,tsx}",
    "src/components/**/*.{js,jsx,tsx}",
    "src/containers/**/*.{js,jsx,tsx}",
    "src/hoc/**/*.{js,jsx,tsx}",
    "src/settings/**/*.{js,jsx,tsx}",
    "src/utils/**/*.{js,jsx,tsx}",
    "src/index.{js,jsx,ts,tsx}"
  ],
  "project": [
    "src/**/*.{js,jsx,ts,tsx}",
    "config/**/*.{js,ts}",
    "scripts/**/*.js"
  ],
  "ignoreDependencies": [
    "@babel/core",
    "@svgr/webpack",
    "babel-core",
    "babel-jest",
    "babel-polyfill",
    "babel-runtime",
    "identity-obj-proxy",
    "promise",
    "react-app-polyfill",
    "react-router",
    "resolve",
    "sass-loader",
    "sw-precache-webpack-plugin",
    "whatwg-fetch",
    "eslint-plugin-flowtype",
    "eslint-plugin-import",
    "eslint-plugin-jsx-a11y",
    "less",
    "less-watch-compiler",
    "react-test-renderer",
    "webpack-cli"
  ],
  "ignoreExportsUsedInFile": true
}

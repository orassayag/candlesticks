{
  "name": "candlesticks-client",
  "version": "0.1.0",
  "private": false,
  "description": "A real-time financial charting app that generates live candlestick price charts with configurable intervals. Built with React.js, Node.js, and WebSockets for live streaming, it simulates market data, transforms it into candlestick format, and visualizes it in real time using Google Charts UI",
  "keywords": [
    "real-time",
    "financial",
    "charting",
    "candlestick",
    "stocks",
    "market",
    "data",
    "visualization",
    "websockets",
    "streaming",
    "react",
    "nodejs",
    "javascript",
    "typescript",
    "google-charts",
    "trading",
    "simulation",
    "analytics",
    "frontend",
    "backend"
  ],
  "homepage": "https://github.com/orassayag/candlesticks#readme",
  "bugs": {
    "url": "https://github.com/orassayag/candlesticks/issues"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/orassayag/candlesticks.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/orassayag"
  },
  "license": "MIT",
  "author": {
    "name": "Or Assayag",
    "email": "orassayag@gmail.com",
    "url": "https://github.com/orassayag"
  },
  "contributors": [
    {
      "name": "Or Assayag",
      "email": "orassayag@gmail.com",
      "url": "https://github.com/orassayag"
    }
  ],
  "type": "commonjs",
  "main": "src/registerServiceWorker.js",
  "files": [
    ".vscode",
    "config",
    "public",
    "scripts",
    "src",
    ".eslintrc.json",
    ".gitignore",
    ".prettierrc",
    ".stylelintrc",
    "knip.json",
    "package-lock.json",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node scripts/start.js",
    "test": "node scripts/test.js"
  },
  "babel": {
    "presets": [
      "react-app"
    ]
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "eslintConfig": {
    "extends": "react-app"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}"
    ],
    "moduleFileExtensions": [
      "web.js",
      "js",
      "json",
      "web.jsx",
      "jsx",
      "node"
    ],
    "moduleNameMapper": {
      "^react-native$": "react-native-web",
      "^.+\\.module\\.(css|sass|scss)$": "identity-obj-proxy"
    },
    "resolver": "jest-pnp-resolver",
    "setupFiles": [
      "react-app-polyfill/jsdom"
    ],
    "testEnvironment": "jsdom",
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.{js,jsx}",
      "<rootDir>/src/**/?(*.)(spec|test).{js,jsx}"
    ],
    "testURL": "http://localhost",
    "transform": {
      "^.+\\.(js|jsx)$": "<rootDir>/node_modules/babel-jest",
      "^.+\\.css$": "<rootDir>/config/jest/cssTransform.js",
      "^(?!.*\\.(js|jsx|css|json)$)": "<rootDir>/config/jest/fileTransform.js"
    },
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\].+\\.(js|jsx)$",
      "^.+\\.module\\.(css|sass|scss)$"
    ]
  },
  "dependencies": {
    "@babel/core": "7.1.0",
    "@svgr/webpack": "8.1.0",
    "autoprefixer": "^9.2.1",
    "axios": "^0.18.0",
    "babel-core": "7.0.0-bridge.0",
    "babel-eslint": "9.0.0",
    "babel-jest": "23.6.0",
    "babel-loader": "8.0.4",
    "babel-plugin-named-asset-import": "^0.2.2",
    "babel-polyfill": "^6.26.0",
    "babel-preset-react-app": "^5.0.4",
    "babel-runtime": "^6.26.0",
    "bfj": "6.1.1",
    "case-sensitive-paths-webpack-plugin": "2.1.2",
    "chalk": "2.4.1",
    "dotenv": "6.0.0",
    "dotenv-expand": "4.2.0",
    "file-loader": "2.0.0",
    "fs-extra": "7.0.0",
    "html-webpack-plugin": "4.0.0-alpha.2",
    "identity-obj-proxy": "3.0.0",
    "moment": "^2.22.2",
    "optimize-css-assets-webpack-plugin": "6.0.1",
    "pnp-webpack-plugin": "1.1.0",
    "postcss-flexbugs-fixes": "4.1.0",
    "postcss-loader": "3.0.0",
    "postcss-preset-env": "6.0.6",
    "postcss-safe-parser": "4.0.1",
    "promise": "^8.0.2",
    "prop-types": "^15.6.2",
    "react": "^16.5.2",
    "react-app-polyfill": "^0.1.3",
    "react-dev-utils": "^6.0.5",
    "react-dom": "^16.5.2",
    "react-google-charts": "^3.0.10",
    "react-router": "^4.3.1",
    "react-router-dom": "^4.3.1",
    "resolve": "1.8.1",
    "sass-loader": "7.1.0",
    "socket.io-client": "^2.1.1",
    "sw-precache-webpack-plugin": "^0.11.5",
    "terser-webpack-plugin": "1.1.0",
    "url-loader": "1.1.1",
    "webpack-dev-server": "3.1.9",
    "webpack-manifest-plugin": "2.0.4",
    "whatwg-fetch": "^3.0.0",
    "workbox-webpack-plugin": "3.6.2"
  },
  "devDependencies": {
    "css-loader": "^1.0.0",
    "eslint": "^5.8.0",
    "eslint-config-react-app": "^3.0.4",
    "eslint-loader": "^2.1.1",
    "eslint-plugin-flowtype": "^2.50.1",
    "eslint-plugin-import": "^2.14.0",
    "eslint-plugin-jsx-a11y": "^6.1.2",
    "eslint-plugin-react": "^7.11.1",
    "less": "^3.8.1",
    "jest": "30.4.2",
    "less-loader": "^4.1.0",
    "less-watch-compiler": "^1.12.1",
    "mini-css-extract-plugin": "^0.4.3",
    "react-test-renderer": "^16.5.2",
    "style-loader": "^0.23.0",
    "webpack": "^4.19.1",
    "webpack-cli": "^3.1.2"
  }
}
